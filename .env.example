# Never commit the real values. The Contabo file is /opt/stack/sites/krain-studio/.env.runtime.calendar-sync.
KRAIN_CALENDAR_DB_PATH=/data/krain-calendar-sync.db
KRAIN_CALENDAR_PUBLIC_URL=https://www.krain.studio
KRAIN_CALENDAR_ENCRYPTION_KEY=
KRAIN_CALENDAR_SETUP_PASSWORD=
KRAIN_CALENDAR_CRON_SECRET=
# Personal Outlook.com calendars use `consumers`.
KRAIN_MICROSOFT_TENANT_ID=consumers
KRAIN_MICROSOFT_CLIENT_ID=
KRAIN_MICROSOFT_CLIENT_SECRET=
# Leave as primary unless Krain uses a named Outlook calendar.
KRAIN_MICROSOFT_CALENDAR_ID=primary
KRAIN_GOOGLE_CLIENT_ID=
KRAIN_GOOGLE_CLIENT_SECRET=
# Dedicated read-only IMAP accounts. Omit all 4 settings for a mailbox to keep it disabled.
KRAIN_INBOX_KRAIN_HOST=mail.buildsales.homes
KRAIN_INBOX_KRAIN_USER=
KRAIN_INBOX_KRAIN_PASSWORD=
KRAIN_INBOX_KRAIN_PORT=993
KRAIN_INBOX_BUILDSALES_HOST=mail.buildsales.homes
KRAIN_INBOX_BUILDSALES_USER=
KRAIN_INBOX_BUILDSALES_PASSWORD=
KRAIN_INBOX_BUILDSALES_PORT=993
# First enabled pass sets a cursor and imports no old mail. Set true only for a reviewed import.
KRAIN_INBOX_IMPORT_HISTORICAL=false
# Dry run reads and parses but performs no Google write or database mutation.
KRAIN_INBOX_DRY_RUN=false
